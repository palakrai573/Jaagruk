.DS_Store

# The Capacitor Android project IS committed. It starts out generated, but it carries
# hand-made changes -- permissions, minSdk 29, release signing, the pinned Gradle
# checksum -- that cap add would not recreate. android/.gitignore keeps its build output,
# local.properties, keystores and the copied web assets out of git.

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local agent tooling (skill installs, editor launch config). Not part of the app.
.agents/
.claude/
skills-lock.json

# Generated presentation deliverables (docx, diagrams, QA captures). Kept on the
# machine that built them rather than in the repository.
output/documentation/
