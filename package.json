{
  "name": "jaagruk",
  "private": true,
  "version": "1.0.0",
  "description": "AR-based vocational safety training and certification for Jharkhand's mining and manufacturing sector (SIH 26041)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "a11y": "node scripts/a11y-gate.mjs",
    "a11y:selftest": "node scripts/a11y-gate.mjs --selftest",
    "i18n": "node scripts/i18n-gate.mjs",
    "translit": "node scripts/translit-check.mjs",
    "santali:worksheet": "node scripts/santali-worksheet.mjs",
    "verify": "npm run a11y && npm run a11y:selftest && npm run i18n && npm run translit && npm run build",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-nastaliq-urdu": "5.3.0",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/noto-sans-ol-chiki": "5.3.0",
    "@fontsource/noto-sans-oriya": "5.3.0",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
